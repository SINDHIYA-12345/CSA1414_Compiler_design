# Create LEX program
lex_code = r'''%{
%}

%%
(0[1-9]|[12][0-9]|3[01])-(0[1-9]|1[0-2])-[0-9]{4} {
    printf("Valid DOB\n");
}

.* {
    printf("Invalid DOB\n");
}
%%

int yywrap()
{
    return 1;
}

int main()
{
    yyin = fopen("input.txt", "r");

    if (yyin == NULL)
    {
        printf("File not found\n");
        return 1;
    }

    yylex();
    fclose(yyin);

    return 0;
}
'''

with open("q34.l", "w") as f:
    f.write(lex_code)

# Input DOB
with open("input.txt", "w") as f:
    f.write("14-05-2005")

# Compile and run
!flex q34.l
!gcc lex.yy.c -o q34
!./q34
