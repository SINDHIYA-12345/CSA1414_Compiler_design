# Create LEX program
lex_code = r'''%{
%}

%%
[0-9] {
    printf("It is a digit\n");
}

. {
    printf("It is not a digit\n");
}
%%

int yywrap()
{
    return 1;
}

int main()
{
    yyin = fopen("input.txt", "r");

    if (yyin == NULL)
    {
        printf("File not found\n");
        return 1;
    }

    yylex();
    fclose(yyin);

    return 0;
}
'''

with open("q35.l", "w") as f:
    f.write(lex_code)

# Input
with open("input.txt", "w") as f:
    f.write("7")

# Compile and run
!flex q35.l
!gcc lex.yy.c -o q35
!./q35
