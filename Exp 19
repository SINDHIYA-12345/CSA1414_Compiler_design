%%writefile q19.l
%{
int characters = 0;
int words = 0;
int lines = 0;
%}

%%
\n          { lines++; characters++; }
[ \t]+      { characters += yyleng; }
[^ \t\n]+   { words++; characters += yyleng; }
%%

int yywrap()
{
    return 1;
}

int main()
{
    yyin = fopen("sample.c", "r");

    if (yyin == NULL)
    {
        printf("File not found\n");
        return 1;
    }

    yylex();

    printf("Characters = %d\n", characters);
    printf("Words = %d\n", words);
    printf("Lines = %d\n", lines);

    fclose(yyin);

    return 0;
}
