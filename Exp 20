%%writefile q20.l
%{
int macros = 0;
int headers = 0;
%}

%%
^[ \t]*#[ \t]*define[^\n]* {
    macros++;
    printf("Macro: %s", yytext);
}

^[ \t]*#[ \t]*include[^\n]* {
    headers++;
    printf("Header: %s", yytext);
}

[0-9]+(\.[0-9]+)? {
    printf("Constant: %s\n", yytext);
}

\"([^\"\\]|\\.)*\" {
    printf("String Constant: %s\n", yytext);
}

\n ;
. ;
%%

int yywrap()
{
    return 1;
}

int main()
{
    yyin = fopen("sample.c", "r");

    if (yyin == NULL)
    {
        printf("File not found\n");
        return 1;
    }

    yylex();

    printf("\nNumber of Macros = %d\n", macros);
    printf("Number of Header Files = %d\n", headers);

    fclose(yyin);

    return 0;
}
