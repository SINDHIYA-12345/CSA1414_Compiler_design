# Create LEX program
lex_code = r'''%{
#include <stdio.h>
#include <string.h>

int max = 0;
char longest[100];
%}

%%
[a-zA-Z]+ {
    if (yyleng > max)
    {
        max = yyleng;
        strcpy(longest, yytext);
    }
}

[ \t\n]+ ;
. ;
%%

int yywrap()
{
    return 1;
}

int main()
{
    yyin = fopen("input.txt", "r");

    if (yyin == NULL)
    {
        printf("File not found\n");
        return 1;
    }

    yylex();

    printf("Longest Word = %s\n", longest);
    printf("Length = %d\n", max);

    fclose(yyin);

    return 0;
}
'''

with open("q38.l", "w") as f:
    f.write(lex_code)

# Input sentence
with open("input.txt", "w") as f:
    f.write("I am studying Compiler Design")

